{
  "name": "aircontrol",
  "version": "1.3.0",
  "description": "Coordination for parallel Claude Code and Codex sessions, local and in the cloud: roster, claims, advisories, and messaging.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "hooks",
    "coordination",
    "agents"
  ],
  "license": "MIT",
  "author": "Andre Havasi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahavasi/aircontrol.git"
  },
  "homepage": "https://github.com/ahavasi/aircontrol#readme",
  "bugs": {
    "url": "https://github.com/ahavasi/aircontrol/issues"
  },
  "type": "commonjs",
  "bin": {
    "aircontrol": "coord.js",
    "aircontrol-install": "install.js"
  },
  "files": [
    "coord.js",
    "codex-listener.js",
    "cmux-codex-remote.sh",
    "install.js",
    "skills/",
    "cloud-init.js",
    "relay-admin.js",
    "relay/room.js",
    "relay/worker.mjs",
    "relay/wrangler.toml.tmpl",
    "relay/dev-server.js"
  ],
